QUEUE_API_DOCKER_IMAGE=your-dockerhub-user/ticket-queue-api:<git-sha>
QUEUE_SCHEDULER_DOCKER_IMAGE=your-dockerhub-user/ticket-queue-scheduler:<git-sha>
DD_API_KEY=replace-with-datadog-api-key
DD_SITE=us5.datadoghq.com
DD_ENV=prod
DD_VERSION=<git-sha>
JWT_SECRET=replace-with-core-access-token-secret-32-byte-minimum
JWT_ISSUER=ticket
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
QUEUE_TOKEN_SECRET=replace-with-32-byte-minimum-secret
ADMISSION_TOKEN_SECRET_KEY=replace-with-32-byte-minimum-secret
QUEUE_DEFAULT_QUEUE_TTL=24h
QUEUE_ADVANCE_BATCH_SIZE=500
QUEUE_DEFAULT_REFRESH_AFTER_MS=5000
QUEUE_SHARD_COUNT=128
QUEUE_SLOT_SIZE_MILLIS=50
QUEUE_SLOT_CLOSE_GRACE_MILLIS=200
QUEUE_ADVANCE_INTERVAL_MS=1000
